{
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    },
    "main.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py/$1"
    }
  ]
}
