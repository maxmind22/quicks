# ==============================================================================
# Quicks Environment Variables Configuration
# ==============================================================================

# Flask Session Security (random 32+ character hex string)
SECRET_KEY=

# Database Connection URL:
# - Leave empty to use local SQLite (sqlite:///allusers.db) for local testing
# - Or set to your PostgreSQL connection string from Neon or Supabase:
#   postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL=

# Google Gemini API Key (100% Free with no credit card):
# Get free from: https://aistudio.google.com/
GEMINI_API_KEY=
# GOOGLE_API_KEY= (Alternative name also supported)

# Pinecone Vector Store Credentials:
# Get free from: https://app.pinecone.io/
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
